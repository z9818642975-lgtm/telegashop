from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton
from bot.models.product import Product


def products_kb(products: list[Product]) -> InlineKeyboardMarkup:
    keyboard = []

    for p in products:
        status = "РЎР‚РЎСџРЎСџРЎС›" if p.is_active else "Р Р†РЎв„ўР’В«Р С—РЎвЂР РЏ"
        keyboard.append(
            [
                InlineKeyboardButton(
                    text=f"{status} {p.title} ({p.base_price} Р Р†РІР‚С™Р вЂ¦)",
                    callback_data=f"admin:product:card:{p.id}",
                )
            ]
        )

    keyboard.append(
        [
            InlineKeyboardButton(
                text="Р Р†РЎвЂєРІР‚Сћ Р В РІР‚СњР В РЎвЂўР В Р’В±Р В Р’В°Р В Р вЂ Р В РЎвЂР РЋРІР‚С™Р РЋР Р‰ Р РЋРІР‚С™Р В РЎвЂўР В Р вЂ Р В Р’В°Р РЋР вЂљ",
                callback_data="admin:admin:product:create",
            )
        ]
    )
    keyboard.append(
        [
            InlineKeyboardButton(
                text="Р Р†Р’В¬РІР‚В¦Р С—РЎвЂР РЏ Р В РЎСљР В Р’В°Р В Р’В·Р В Р’В°Р В РўвЂ",
                callback_data="admin:admin:panel",
            )
        ]
    )

    return InlineKeyboardMarkup(inline_keyboard=keyboard)
