        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text=f"РЎР‚РЎСџР РЏР’В¬ {wh.title}",
                    callback_data=f"admin:wh:{wh.id}",
                )
            ]
            for wh in items
        ]
