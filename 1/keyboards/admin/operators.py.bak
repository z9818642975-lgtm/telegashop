from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton
from bot.models.user import User


def operators_kb(operators: list[User]) -> InlineKeyboardMarkup:
    keyboard: list[list[InlineKeyboardButton]] = []

    for op in operators:
        status = "РЎР‚РЎСџРЎСџРЎС›" if op.is_active else "Р Р†РЎв„ўР’В«Р С—РЎвЂР РЏ"
        name = op.full_name or op.username or f"ID {op.id}"

        keyboard.append(
            [
                InlineKeyboardButton(
                    text=f"{status} {name}",
                    callback_data=f"admin:operator:toggle:{op.id}",
                )
            ]
        )

    keyboard.append(
        [
            InlineKeyboardButton(
                text="Р Р†Р’В¬РІР‚В¦Р С—РЎвЂР РЏ Р В РЎСљР В Р’В°Р В Р’В·Р В Р’В°Р В РўвЂ",
                callback_data="admin:admin:panel",
            )
        ]
    )

    return InlineKeyboardMarkup(inline_keyboard=keyboard)
