# bot/routers/admin/warehouses_move.py


from __future__ import annotations





from aiogram import Router, F


from aiogram.types import CallbackQuery, Message


from aiogram.fsm.context import FSMContext


from sqlalchemy.ext.asyncio import AsyncSession





from bot.filters.role import RoleFilter


from bot.fsm.admin_move_fsm import AdminMoveFSM


from bot.dao.warehouses_dao import WarehousesDAO


from bot.dao.products_dao import ProductsDAO





router = Router(name="admin_warehouse_move")








# ============================================================


# РЎР‚РЎСџРІР‚СњР С“ Р В РІР‚в„ўР В Р’В«Р В РІР‚ВР В РЎвЂєР В Р’В  Р В Р’ВР В Р Р‹Р В РўС’Р В РЎвЂєР В РІР‚СњР В РЎСљР В РЎвЂєР В РІР‚СљР В РЎвЂє Р В Р Р‹Р В РЎв„ўР В РІР‚С”Р В РЎвЂ™Р В РІР‚СњР В РЎвЂ™


# ============================================================





@router.callback_query(RoleFilter("admin"), F.data == "admin:admin:move:start")


async def move_start(call: CallbackQuery, state: FSMContext | None = None, session: AsyncSession | None = None):


    dao = WarehousesDAO(session)


    warehouses = await dao.get_all()





    await state.set_state(AdminMoveFSM.from_warehouse)





    text = "РЎР‚РЎСџРІР‚СњР С“ <b>Р В РЎСџР В Р’ВµР РЋР вЂљР В Р’ВµР В РЎВР В Р’ВµР РЋРІР‚В°Р В Р’ВµР В Р вЂ¦Р В РЎвЂР В Р’Вµ Р РЋРІР‚С™Р В РЎвЂўР В Р вЂ Р В Р’В°Р РЋР вЂљР В Р’В°</b>\n\nР В РІР‚в„ўР РЋРІР‚в„–Р В Р’В±Р В Р’ВµР РЋР вЂљР В РЎвЂР РЋРІР‚С™Р В Р’Вµ Р РЋР С“Р В РЎвЂќР В Р’В»Р В Р’В°Р В РўвЂ-Р В РЎвЂР РЋР С“Р РЋРІР‚С™Р В РЎвЂўР РЋРІР‚РЋР В Р вЂ¦Р В РЎвЂР В РЎвЂќ:"


    kb = [


        [("РЎР‚РЎСџР РЏР’В¬ " + w.title, f"admin:move:from:{w.id}")]


        for w in warehouses


    ]





    await call.message.edit_text(text, reply_markup=dao.inline_kb(kb))








# ============================================================


# РЎР‚РЎСџР РЏР’В¬ FROM


# ============================================================





@router.callback_query(RoleFilter("admin"), F.data.startswith("admin:admin:move:from:"))


async def choose_from(


    call: CallbackQuery,


    state: FSMContext | None = None,


):


    from_id = int(call.data.split(":")[-1])


    await state.update_data(from_wh=from_id)


    await state.set_state(AdminMoveFSM.to_warehouse)





    await call.message.edit_text("Р Р†РЎвЂєР Р‹Р С—РЎвЂР РЏ Р В РІР‚в„ўР РЋРІР‚в„–Р В Р’В±Р В Р’ВµР РЋР вЂљР В РЎвЂР РЋРІР‚С™Р В Р’Вµ Р РЋР С“Р В РЎвЂќР В Р’В»Р В Р’В°Р В РўвЂ-Р В РЎвЂ”Р В РЎвЂўР В Р’В»Р РЋРЎвЂњР РЋРІР‚РЋР В Р’В°Р РЋРІР‚С™Р В Р’ВµР В Р’В»Р РЋР Р‰:")








# ============================================================


# РЎР‚РЎСџР РЏР’В¬ TO


# ============================================================





@router.callback_query(RoleFilter("admin"), F.data.startswith("admin:admin:move:to:"))


async def choose_to(


    call: CallbackQuery,


    state: FSMContext | None = None,


):


    to_id = int(call.data.split(":")[-1])


    await state.update_data(to_wh=to_id)


    await state.set_state(AdminMoveFSM.product)





    await call.message.edit_text("РЎР‚РЎСџРІР‚СљР’В¦ Р В РІР‚в„ўР В Р вЂ Р В Р’ВµР В РўвЂР В РЎвЂР РЋРІР‚С™Р В Р’Вµ ID Р РЋРІР‚С™Р В РЎвЂўР В Р вЂ Р В Р’В°Р РЋР вЂљР В Р’В°:")








# ============================================================


# РЎР‚РЎСџРІР‚СљР’В¦ PRODUCT


# ============================================================





@router.message(RoleFilter("admin"), AdminMoveFSM.product)


async def enter_product(message, *, state: FSMContext | None = None,


):


    if not message.text.isdigit():


        await message.answer("Р Р†РЎСљР Р‰ Р В РІР‚в„ўР В Р вЂ Р В Р’ВµР В РўвЂР В РЎвЂР РЋРІР‚С™Р В Р’Вµ Р РЋРІР‚РЋР В РЎвЂР РЋР С“Р В Р’В»Р В РЎвЂўР В Р вЂ Р В РЎвЂўР В РІвЂћвЂ“ ID Р РЋРІР‚С™Р В РЎвЂўР В Р вЂ Р В Р’В°Р РЋР вЂљР В Р’В°")


        return





    await state.update_data(product_id=int(message.text))


    await state.set_state(AdminMoveFSM.qty)





    await message.answer("РЎР‚РЎСџРІР‚СњРЎС› Р В РІР‚в„ўР В Р вЂ Р В Р’ВµР В РўвЂР В РЎвЂР РЋРІР‚С™Р В Р’Вµ Р В РЎвЂќР В РЎвЂўР В Р’В»Р В РЎвЂР РЋРІР‚РЋР В Р’ВµР РЋР С“Р РЋРІР‚С™Р В Р вЂ Р В РЎвЂў:")








# ============================================================


# РЎР‚РЎСџРІР‚СњРЎС› QTY Р Р†РІР‚В РІР‚в„ў MOVE


# ============================================================





@router.message(RoleFilter("admin"), AdminMoveFSM.qty)


async def do_move(message, *, state: FSMContext | None = None,


    session: AsyncSession | None = None,


):


    if not message.text.isdigit():


        await message.answer("Р Р†РЎСљР Р‰ Р В РЎв„ўР В РЎвЂўР В Р’В»Р В РЎвЂР РЋРІР‚РЋР В Р’ВµР РЋР С“Р РЋРІР‚С™Р В Р вЂ Р В РЎвЂў Р В РўвЂР В РЎвЂўР В Р’В»Р В Р’В¶Р В Р вЂ¦Р В РЎвЂў Р В Р’В±Р РЋРІР‚в„–Р РЋРІР‚С™Р РЋР Р‰ Р РЋРІР‚РЋР В РЎвЂР РЋР С“Р В Р’В»Р В РЎвЂўР В РЎВ")


        return





    data = await state.get_data()





    qty = int(message.text)


    from_wh = data["from_wh"]


    to_wh = data["to_wh"]


    product_id = data["product_id"]





    wh_dao = WarehousesDAO(session)


    products = await ProductsDAO.list_all(session)





    await wh_dao.move_product(


        product_id=product_id,


        qty=qty,


        from_wh_id=from_wh,


        to_wh_id=to_wh,


    )





    await session.commit()


    await state.clear()





    await message.answer(


        f"Р Р†РЎС™РІР‚В¦ Р В РЎСџР В Р’ВµР РЋР вЂљР В Р’ВµР В РЎВР В Р’ВµР РЋРІР‚В°Р В Р’ВµР В Р вЂ¦Р В РЎвЂР В Р’Вµ Р В Р вЂ Р РЋРІР‚в„–Р В РЎвЂ”Р В РЎвЂўР В Р’В»Р В Р вЂ¦Р В Р’ВµР В Р вЂ¦Р В РЎвЂў\n"


        f"Р В РЎС›Р В РЎвЂўР В Р вЂ Р В Р’В°Р РЋР вЂљ #{product_id}\n"


        f"{qty} Р РЋРІвЂљВ¬Р РЋРІР‚С™."


    )





