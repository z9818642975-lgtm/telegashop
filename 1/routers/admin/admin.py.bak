        f"Р В Р вЂ Р РЋРЎв„ўР Р†Р вЂљР’В¦ Р В Р’В Р РЋРІР‚С”Р В Р’В Р РЋРІР‚вЂќР В Р’В Р вЂ™Р’В»Р В Р’В Р вЂ™Р’В°Р В Р Р‹Р Р†Р вЂљР Р‹Р В Р’В Р вЂ™Р’ВµР В Р’В Р В РІР‚В¦Р В Р’В Р РЋРІР‚Сћ: {data['orders_paid']}\n"
        f"Р РЋР вЂљР РЋРЎСџР Р†Р вЂљРІвЂћСћР вЂ™Р’В° Р В Р’В Р РЋРІР‚С”Р В Р’В Р вЂ™Р’В±Р В Р’В Р РЋРІР‚СћР В Р Р‹Р В РІР‚С™Р В Р’В Р РЋРІР‚СћР В Р Р‹Р Р†Р вЂљРЎв„ў: {data['revenue']} Р В Р вЂ Р Р†Р вЂљРЎв„ўР В РІР‚В¦\n"
        f"Р РЋР вЂљР РЋРЎСџР вЂ™Р’В§Р РЋРІР‚Сћ Р В Р’В Р В Р вЂ№Р В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’ВµР В Р’В Р СћРІР‚ВР В Р’В Р В РІР‚В¦Р В Р’В Р РЋРІР‚ВР В Р’В Р Р†РІР‚С›РІР‚вЂњ Р В Р Р‹Р Р†Р вЂљР Р‹Р В Р’В Р вЂ™Р’ВµР В Р’В Р РЋРІР‚Сњ: {data['avg_check']} Р В Р вЂ Р Р†Р вЂљРЎв„ўР В РІР‚В¦",
        parse_mode="HTML",
    )
    await call.answer()

@router.callback_query(F.data == "admin:admin:stats:per_operator")
async def stats_per_operator(call: CallbackQuery, session: AsyncSession | None = None):
    dao = StatisticsDAO(session)
    rows = await dao.per_operator(days=30)

    text = "Р РЋР вЂљР РЋРЎСџР Р†Р вЂљР’ВР вЂ™Р’В¤ <b>Р В Р’В Р РЋРІР‚С”Р В Р’В Р РЋРІР‚вЂќР В Р’В Р вЂ™Р’ВµР В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’В°Р В Р Р‹Р Р†Р вЂљРЎв„ўР В Р’В Р РЋРІР‚СћР В Р Р‹Р В РІР‚С™Р В Р Р‹Р Р†Р вЂљРІвЂћвЂ“ (30 Р В Р’В Р СћРІР‚ВР В Р’В Р В РІР‚В¦Р В Р’В Р вЂ™Р’ВµР В Р’В Р Р†РІР‚С›РІР‚вЂњ)</b>\n\n"
    for r in rows:
        text += f"{r['name']}\n  Р РЋР вЂљР РЋРЎСџР Р†Р вЂљРЎС™Р вЂ™Р’В¦ {r['orders']} | Р РЋР вЂљР РЋРЎСџР Р†Р вЂљРІвЂћСћР вЂ™Р’В° {r['revenue']} Р В Р вЂ Р Р†Р вЂљРЎв„ўР В РІР‚В¦\n"

    await call.message.edit_text(text, parse_mode="HTML")
    await call.answer()

@router.callback_query(F.data == "admin:admin:stats:per_warehouse")
async def stats_per_warehouse(call: CallbackQuery, session: AsyncSession | None = None):
    dao = StatisticsDAO(session)
    rows = await dao.per_warehouse(days=30)

    text = "Р РЋР вЂљР РЋРЎСџР В Р РЏР вЂ™Р’В¬ <b>Р В Р’В Р В Р вЂ№Р В Р’В Р РЋРІР‚СњР В Р’В Р вЂ™Р’В»Р В Р’В Р вЂ™Р’В°Р В Р’В Р СћРІР‚ВР В Р Р‹Р Р†Р вЂљРІвЂћвЂ“ (30 Р В Р’В Р СћРІР‚ВР В Р’В Р В РІР‚В¦Р В Р’В Р вЂ™Р’ВµР В Р’В Р Р†РІР‚С›РІР‚вЂњ)</b>\n\n"
    for r in rows:
        text += f"{r['title']}\n  Р РЋР вЂљР РЋРЎСџР Р†Р вЂљРЎС™Р вЂ™Р’В¦ {r['orders']} | Р РЋР вЂљР РЋРЎСџР Р†Р вЂљРІвЂћСћР вЂ™Р’В° {r['revenue']} Р В Р вЂ Р Р†Р вЂљРЎв„ўР В РІР‚В¦\n"

    await call.message.edit_text(text, parse_mode="HTML")
    await call.answer()

@router.callback_query(F.data == "admin:admin:stats:graph")
async def stats_graph(call: CallbackQuery, session: AsyncSession | None = None):
    dao = StatisticsDAO(session)
    data = await dao.revenue_timeseries(days=30)

    text = "Р РЋР вЂљР РЋРЎСџР Р†Р вЂљРЎС™Р Р†РІР‚С™Р’В¬ <b>Р В Р’В Р Р†Р вЂљРІвЂћСћР В Р Р‹Р Р†Р вЂљРІвЂћвЂ“Р В Р Р‹Р В РІР‚С™Р В Р Р‹Р РЋРІР‚СљР В Р Р‹Р Р†Р вЂљР Р‹Р В Р’В Р РЋРІР‚СњР В Р’В Р вЂ™Р’В° Р В Р’В Р РЋРІР‚вЂќР В Р’В Р РЋРІР‚Сћ Р В Р’В Р СћРІР‚ВР В Р’В Р В РІР‚В¦Р В Р Р‹Р В Р РЏР В Р’В Р РЋР’В (30 Р В Р’В Р СћРІР‚ВР В Р’В Р В РІР‚В¦Р В Р’В Р вЂ™Р’ВµР В Р’В Р Р†РІР‚С›РІР‚вЂњ)</b>\n\n"
    for d in data:
        text += f"{d['date']} Р В Р вЂ Р Р†Р вЂљР’В Р Р†Р вЂљРІвЂћСћ {d['revenue']} Р В Р вЂ Р Р†Р вЂљРЎв„ўР В РІР‚В¦\n"

    await call.message.edit_text(text, parse_mode="HTML")
    await call.answer()

