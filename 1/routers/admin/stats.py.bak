from aiogram import Router, F


from aiogram.types import CallbackQuery


from sqlalchemy.ext.asyncio import AsyncSession





from bot.dao.statistics import StatisticsDAO





router = Router(name="admin_stats")








# ------------------------------------------------------------


# Р В Р Р‹Р В РІР‚в„ўР В РЎвЂєР В РІР‚СњР В РЎв„ўР В РЎвЂ™


# ------------------------------------------------------------





@router.callback_query(F.data == "admin:admin:stats:summary")


async def admin_stats_summary(


    callback: CallbackQuery,


    session: AsyncSession | None = None,


) -> None:


    dao = StatisticsDAO(session)


    data = await dao.today_summary()





    await callback.message.edit_text(


        "РЎР‚РЎСџРІР‚СљР вЂ° <b>Р В Р Р‹Р РЋРІР‚С™Р В Р’В°Р РЋРІР‚С™Р В РЎвЂР РЋР С“Р РЋРІР‚С™Р В РЎвЂР В РЎвЂќР В Р’В° Р В Р’В·Р В Р’В° Р РЋР С“Р В Р’ВµР В РЎвЂ“Р В РЎвЂўР В РўвЂР В Р вЂ¦Р РЋР РЏ</b>\n\n"


        f"РЎР‚РЎСџРІР‚СљР’В¦ Р В РІР‚вЂќР В Р’В°Р В РЎвЂќР В Р’В°Р В Р’В·Р В РЎвЂўР В Р вЂ : {data['orders_total']}\n"


        f"Р Р†РЎС™РІР‚В¦ Р В РЎвЂєР В РЎвЂ”Р В Р’В»Р В Р’В°Р РЋРІР‚РЋР В Р’ВµР В Р вЂ¦Р В РЎвЂў: {data['orders_paid']}\n"


        f"РЎР‚РЎСџРІР‚в„ўР’В° Р В РЎвЂєР В Р’В±Р В РЎвЂўР РЋР вЂљР В РЎвЂўР РЋРІР‚С™: {data['revenue']} Р Р†РІР‚С™Р вЂ¦\n"


        f"РЎР‚РЎСџР’В§РЎвЂў Р В Р Р‹Р РЋР вЂљР В Р’ВµР В РўвЂР В Р вЂ¦Р В РЎвЂР В РІвЂћвЂ“ Р РЋРІР‚РЋР В Р’ВµР В РЎвЂќ: {data['avg_check']} Р Р†РІР‚С™Р вЂ¦\n\n"


        f"РЎР‚РЎСџРІР‚ВР’В· Р В РЎвЂєР В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’В°Р РЋРІР‚С™Р В РЎвЂўР РЋР вЂљР В РЎвЂўР В Р вЂ  Р В Р вЂ Р РЋР С“Р В Р’ВµР В РЎвЂ“Р В РЎвЂў: {data['operators_total']}\n"


        f"РЎР‚РЎСџРЎСџРЎС› Р В РЎвЂ™Р В РЎвЂќР РЋРІР‚С™Р В РЎвЂР В Р вЂ Р В Р вЂ¦Р РЋРІР‚в„–Р РЋРІР‚В¦ Р РЋР С“Р В РЎВР В Р’ВµР В Р вЂ¦: {data['active_shifts']}\n\n"


        f"РЎР‚РЎСџРІР‚в„ўРЎвЂ Р В РЎСљР В Р’В°Р РЋРІР‚РЋР В РЎвЂР РЋР С“Р В Р’В»Р В Р’ВµР В Р вЂ¦Р В РЎвЂў Р В Р’В·Р В Р’В°Р РЋР вЂљР В РЎвЂ”Р В Р’В»Р В Р’В°Р РЋРІР‚С™: {data['salary_today']} Р Р†РІР‚С™Р вЂ¦",


        parse_mode="HTML",


    )


    await callback.answer()








# ------------------------------------------------------------


# Р В РІР‚вЂќР В РЎвЂ™Р В РЎв„ўР В РЎвЂ™Р В РІР‚вЂќР В Р’В«: Р В Р Р‹Р В РЎС›Р В РЎвЂ™Р В РЎС›Р В Р в‚¬Р В Р Р‹Р В Р’В« + Р В РЎС›Р В РЎвЂ™Р В РІвЂћСћР В РЎС™Р В Р’ВР В РЎСљР В РІР‚СљР В Р’В


# ------------------------------------------------------------





@router.callback_query(F.data == "admin:admin:stats:orders")


async def admin_stats_orders(


    callback: CallbackQuery,


    session: AsyncSession | None = None,


) -> None:


    dao = StatisticsDAO(session)





    statuses = await dao.orders_by_status_today()


    timings = await dao.order_timings_today()





    text = "РЎР‚РЎСџРІР‚СљР’В¦ <b>Р В РІР‚вЂќР В Р’В°Р В РЎвЂќР В Р’В°Р В Р’В·Р РЋРІР‚в„– Р В Р’В·Р В Р’В° Р РЋР С“Р В Р’ВµР В РЎвЂ“Р В РЎвЂўР В РўвЂР В Р вЂ¦Р РЋР РЏ</b>\n\n"





    for status, count in statuses.items():


        text += f"{status}: {count}\n"





    text += (


        f"\nР Р†Р РЏР’В± <b>Р В Р Р‹Р РЋР вЂљР В Р’ВµР В РўвЂР В Р вЂ¦Р В Р’ВµР В Р’Вµ Р В Р вЂ Р РЋР вЂљР В Р’ВµР В РЎВР РЋР РЏ</b>\n"


        f"Р Р†РІР‚В РІР‚в„ў Р В РўвЂР В РЎвЂў Р В РЎвЂўР В РЎвЂ”Р В Р’В»Р В Р’В°Р РЋРІР‚С™Р РЋРІР‚в„–: {timings['to_paid_min']} Р В РЎВР В РЎвЂР В Р вЂ¦\n"


        f"Р Р†РІР‚В РІР‚в„ў Р В РўвЂР В РЎвЂў Р В РЎвЂўР РЋРІР‚С™Р В РЎвЂ”Р РЋР вЂљР В Р’В°Р В Р вЂ Р В РЎвЂќР В РЎвЂ: {timings['to_sent_min']} Р В РЎВР В РЎвЂР В Р вЂ¦"


    )





    await callback.message.edit_text(text, parse_mode="HTML")


    await callback.answer()








# ------------------------------------------------------------


# Р В РЎвЂєР В РЎСџР В РІР‚СћР В Р’В Р В РЎвЂ™Р В РЎС›Р В РЎвЂєР В Р’В Р В Р’В«: SLA


# ------------------------------------------------------------





@router.callback_query(F.data == "admin:admin:stats:operators")


async def admin_stats_operators(


    callback: CallbackQuery,


    session: AsyncSession | None = None,


) -> None:


    dao = StatisticsDAO(session)


    data = await dao.operators_sla_today()





    await callback.message.edit_text(


        "РЎР‚РЎСџРІР‚ВР’В· <b>Р В РЎвЂєР В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’В°Р РЋРІР‚С™Р В РЎвЂўР РЋР вЂљР РЋРІР‚в„– Р В Р’В·Р В Р’В° Р РЋР С“Р В Р’ВµР В РЎвЂ“Р В РЎвЂўР В РўвЂР В Р вЂ¦Р РЋР РЏ</b>\n\n"


        f"РЎР‚РЎСџРЎСџРЎС› Р В Р Р‹Р В РЎВР В Р’ВµР В Р вЂ¦ Р В РЎвЂўР РЋРІР‚С™Р В РЎвЂќР РЋР вЂљР РЋРІР‚в„–Р РЋРІР‚С™Р В РЎвЂў: {data['shifts_total']}\n"


        f"Р Р†РЎС™РІР‚В¦ Р В Р Р‹Р В РЎВР В Р’ВµР В Р вЂ¦ Р В Р’В·Р В Р’В°Р В РЎвЂќР РЋР вЂљР РЋРІР‚в„–Р РЋРІР‚С™Р В РЎвЂў: {data['shifts_closed']}\n"


        f"РЎР‚РЎСџРЎв„ўР’В« Р В РІР‚в„ўР РЋРІР‚в„–Р В РЎвЂќР В РЎвЂР В Р вЂ¦Р РЋРЎвЂњР РЋРІР‚С™Р В РЎвЂў Р РЋР С“Р В РЎвЂў Р РЋР С“Р В РЎВР В Р’ВµР В Р вЂ¦Р РЋРІР‚в„–: {data['kicked']}",


        parse_mode="HTML",


    )


    await callback.answer()








# ------------------------------------------------------------


# Р В РІР‚в„ўР В Р’В«Р В Р’В Р В Р в‚¬Р В Р’В§Р В РЎв„ўР В РЎвЂ™: Р В РІР‚ВР В РЎвЂ™Р В РЎСљР В РЎв„ў vs Р В Р Р‹Р В РІР‚ВР В РЎСџ


# ------------------------------------------------------------





@router.callback_query(F.data == "admin:admin:stats:revenue")


async def admin_stats_revenue(


    callback: CallbackQuery,


    session: AsyncSession | None = None,


) -> None:


    dao = StatisticsDAO(session)


    data = await dao.revenue_by_method_today()





    text = "РЎР‚РЎСџРІР‚в„ўР’В° <b>Р В РІР‚в„ўР РЋРІР‚в„–Р РЋР вЂљР РЋРЎвЂњР РЋРІР‚РЋР В РЎвЂќР В Р’В° Р В Р’В·Р В Р’В° Р РЋР С“Р В Р’ВµР В РЎвЂ“Р В РЎвЂўР В РўвЂР В Р вЂ¦Р РЋР РЏ</b>\n\n"


    for method, amount in data.items():


        text += f"{method}: {amount} Р Р†РІР‚С™Р вЂ¦\n"





    await callback.message.edit_text(text, parse_mode="HTML")


    await callback.answer()





