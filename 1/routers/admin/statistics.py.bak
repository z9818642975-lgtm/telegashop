from aiogram import Router, F
from aiogram.types import CallbackQuery
from sqlalchemy.ext.asyncio import AsyncSession

from bot.filters.role import RoleFilter
from bot.dao.statistics_dao import StatisticsDAO

router = Router(name="admin_statistics")

@router.callback_query(RoleFilter("admin"), F.data == "admin:admin:stats:week")
async def stats_week(cb, *, session: AsyncSession | None = None):
    dao = StatisticsDAO(session)
    d = await dao.period_summary(days=7)
    await cb.message.edit_text(
        "РЎР‚РЎСџРІР‚СљР вЂ° <b>Р В РЎСљР В Р’ВµР В РўвЂР В Р’ВµР В Р’В»Р РЋР РЏ</b>\n\n"
        f"РЎР‚РЎСџРІР‚СљР’В¦ {d['orders_total']}\n"
        f"Р Р†РЎС™РІР‚В¦ {d['orders_paid']}\n"
        f"РЎР‚РЎСџРІР‚в„ўР’В° {d['revenue']} Р Р†РІР‚С™Р вЂ¦\n"
        f"РЎР‚РЎСџР’В§РЎвЂў {d['avg_check']} Р Р†РІР‚С™Р вЂ¦",
        parse_mode="HTML",
    )
    await cb.answer()

@router.callback_query(RoleFilter("admin"), F.data == "admin:admin:stats:month")
async def stats_month(cb, *, session: AsyncSession | None = None):
    dao = StatisticsDAO(session)
    d = await dao.period_summary(days=30)
    await cb.message.edit_text(
        "РЎР‚РЎСџРІР‚СљР вЂ° <b>Р В РЎС™Р В Р’ВµР РЋР С“Р РЋР РЏР РЋРІР‚В </b>\n\n"
        f"РЎР‚РЎСџРІР‚СљР’В¦ {d['orders_total']}\n"
        f"Р Р†РЎС™РІР‚В¦ {d['orders_paid']}\n"
        f"РЎР‚РЎСџРІР‚в„ўР’В° {d['revenue']} Р Р†РІР‚С™Р вЂ¦\n"
        f"РЎР‚РЎСџР’В§РЎвЂў {d['avg_check']} Р Р†РІР‚С™Р вЂ¦",
        parse_mode="HTML",
    )
    await cb.answer()


