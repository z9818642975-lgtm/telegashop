from aiogram.types import CallbackQuery

from bot.constants.callbacks_client import (
    ClientDeliveryPickup,
    ClientDeliveryCourier,
    ClientDeliveryPrice,
    ClientPayBank,
    ClientPaySBP,
    ClientPaymentDone,
    ClientPaymentCancel,
)
from bot.constants.callbacks import 

router = Router(name="client_checkout")


@router.callback_query(ClientDeliveryPickup.filter())
async def delivery_pickup(cb: CallbackQuery):
    await cb.answer("Самовывоз выбран")


@router.callback_query(ClientDeliveryCourier.filter())
async def delivery_courier(cb: CallbackQuery):
    await cb.answer("Курьер выбран")


@router.callback_query(ClientDeliveryPrice.filter())
async def delivery_price(cb: CallbackQuery, callback_data: ClientDeliveryPrice):
    await cb.answer(f"Метод: {callback_data.method}")


@router.callback_query(ClientPayBank.filter())
async def pay_bank(cb: CallbackQuery, callback_data: ClientPayBank):
    await cb.answer(f"Банк #{callback_data.bank_id}")


@router.callback_query(ClientPaySBP.filter())
async def pay_sbp(cb: CallbackQuery):
    await cb.answer("СБП выбран")


@router.callback_query(ClientPaymentDone.filter())
async def payment_done(cb: CallbackQuery):
    await cb.message.edit_text("✅ Оплата принята")
    await cb.answer()


@router.callback_query(ClientPaymentCancel.filter())
async def payment_cancel(cb: CallbackQuery):
    await cb.message.edit_text("❌ Оплата отменена")
    await cb.answer()


@router.callback_query(.filter())
async def back_menu(cb: CallbackQuery):
    await cb.message.edit_text("📦 Главное меню")
    await cb.answer()



@router.callback_query(ClientDeliveryCourier.filter())
async def delivery_courier(cb: CallbackQuery, state: FSMContext):
    await state.update_data(delivery="courier")
    await state.set_state(CheckoutFSM.address)
    await cb.message.answer("Введите адрес доставки")
    await cb.answer()


@router.callback_query(ClientDeliveryPrice.filter())
async def delivery_price(
    cb: CallbackQuery,
    callback_data: ClientDeliveryPrice,
):
    await cb.answer(f"Выбран способ: {callback_data.method}")


@router.message(CheckoutFSM.address)
async def checkout_address(
    msg: Message,
    state: FSMContext,
    session: AsyncSession,
):
    data = await state.get_data()

    await OrdersDAO(session).set_delivery_address(
        tg_id=msg.from_user.id,
        address=msg.text,
        delivery_method=data.get("delivery"),
    )

    await state.clear()
    await msg.answer("Адрес сохранён. Продолжаем оформление заказа.")

