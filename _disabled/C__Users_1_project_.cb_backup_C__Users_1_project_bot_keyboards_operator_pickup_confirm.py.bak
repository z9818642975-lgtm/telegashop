from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton

from bot.constants.callbacks import OperatorPickupConfirmCB


def pickup_confirm_kb(order_id: int) -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="✅ Подтвердить",
                    callback_data=OperatorPickupConfirmCB(
                        order_id=order_id,
                        result="confirm",
                    ).pack(),
                ),
                InlineKeyboardButton(
                    text="❌ Отменить",
                    callback_data=OperatorPickupConfirmCB(
                        order_id=order_id,
                        result="cancel",
                    ).pack(),
                ),
            ]
        ]
    )
